        }

        // دالة إنشاء خيارات عشوائية لسؤال معين
        function generateOptions(correctWord, correctMeaning) {
            let optionsSet = new Set();
            optionsSet.add(correctMeaning);
            
            // جمع معاني عشوائية من القاموس
            while (optionsSet.size < 4) {
                const randomIndex = Math.floor(Math.random() * dictionary.length);
                const randomMeaning = dictionary[randomIndex][1];
                if (randomMeaning !== correctMeaning) {
                    optionsSet.add(randomMeaning);
                }
            }
            
            let options = Array.from(optionsSet);
            // خلط ترتيب الخيارات
            for (let i = options.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [options[i], options[j]] = [options[j], options[i]];
            }
            return options;
        }

        // تجهيز جميع الأسئلة
        function prepareQuestions() {
            questions = [];
            for (let i = 0; i < dictionary.length; i++) {
                const word = dictionary[i][0];
                const meaning = dictionary[i][1];
                const options = generateOptions(word, meaning);
                questions.push({
                    word: word,
                    correctMeaning: meaning,
                    options: options
                });
            }
            questions = shuffleArray(questions);
            // إعادة ضبط العدادات
            currentIndex = 0;
            userAnswers = [];
            mistakes = [];
            answerLocked = false;
            updateStats();
            displayCurrentQuestion();
            updateMistakesList();
        }

        // عرض السؤال الحالي
        function displayCurrentQuestion() {
            if (currentIndex >= questions.length) {
                showResult();
                return;
            }
            
            const q = questions[currentIndex];
            document.getElementById('englishWord').innerText = q.word;
            document.getElementById('currentQuestion').innerText = currentIndex + 1;
            document.getElementById('totalQuestions').innerText = questions.length;
            
            // عرض الخيارات
            const container = document.getElementById('optionsContainer');
            container.innerHTML = '';
            q.options.forEach((opt, idx) => {
                const div = document.createElement('div');
                div.className = 'option';
                div.innerText = opt;
                div.onclick = () => checkAnswer(opt, div);
                container.appendChild(div);
            });
            
            // إخفاء التغذية الراجعة
            document.getElementById('feedback').innerHTML = '';
            document.getElementById('feedback').className = 'feedback';
            
            // تحديث شريط التقدم
            const percent = (currentIndex / questions.length) * 100;
            document.getElementById('progressFill').style.width = percent + '%';
            
            answerLocked = false;
            
            // إزالة فئة disabled من الخيارات إذا كانت موجودة
            document.querySelectorAll('.option').forEach(opt => {
                opt.classList.remove('disabled', 'correct', 'wrong');
            });
            
            // تحديث إحصائيات الأزرار
            updateStats();
        }

        // التحقق من الإجابة
        function checkAnswer(selectedMeaning, element) {
            if (answerLocked) return;
            answerLocked = true;
            
            const q = questions[currentIndex];
            const isCorrect = (selectedMeaning === q.correctMeaning);
            
            // تسجيل الإجابة
            userAnswers.push({
                word: q.word,
                selected: selectedMeaning,
                correct: q.correctMeaning,
                isCorrect: isCorrect
            });
            
            if (isCorrect) {
                correctCount++;
                const feedback = document.getElementById('feedback');
                feedback.innerHTML = '✅ إجابة صحيحة! ✅';
                feedback.className = 'feedback feedback-correct';
                element.classList.add('correct');
            } else {
                wrongCount++;
                // إضافة الخطأ إلى قائمة الأخطاء
                mistakes.push({
                    word: q.word,
                    correctMeaning: q.correctMeaning,
                    userAnswer: selectedMeaning
                });
                updateMistakesList();
                
                const feedback = document.getElementById('feedback');
                feedback.innerHTML = `❌ خطأ! الإجابة الصحيحة: ${q.correctMeaning} ❌`;
                feedback.className = 'feedback feedback-wrong';
                element.classList.add('wrong');
                
                // إظهار الإجابة الصحيحة في الخيار الصحيح
                document.querySelectorAll('.option').forEach(opt => {
                    if (opt.innerText === q.correctMeaning) {
                        opt.classList.add('correct');
                    }
                    opt.classList.add('disabled');
                });
            }
            
            updateStats();
        }

        // السؤال التالي
        function nextQuestion() {
            if (!answerLocked) {
                const feedback = document.getElementById('feedback');
                feedback.innerHTML = '⚠️ اختر إجابة أولاً ⚠️';
                feedback.className = 'feedback feedback-wrong';
                setTimeout(() => {
                    if (feedback.innerHTML === '⚠️ اختر إجابة أولاً ⚠️') {
                        feedback.innerHTML = '';
                    }
                }, 1000);
                return;
            }
            
            currentIndex++;
            answerLocked = false;
            
            if (currentIndex < questions.length) {
                displayCurrentQuestion();
            } else {
                showResult();
            }
        }

        // تحديث الإحصائيات
        function updateStats() {
            const totalAnswered = correctCount + wrongCount;
            const percent = totalAnswered === 0 ? 0 : Math.round((correctCount / totalAnswered) * 100);
            document.getElementById('correctCount').innerText = correctCount;
            document.getElementById('wrongCount').innerText = wrongCount;
            document.getElementById('percentCorrect').innerText = percent;
        }

        // تحديث قائمة الأخطاء في اللوحة الجانبية
        function updateMistakesList() {
            const container = document.getElementById('mistakesList');
            if (mistakes.length === 0) {
                container.innerHTML = '<div class="empty-mistakes">✨ لا توجد أخطاء بعد! ✨</div>';
                return;
            }
            
            container.innerHTML = '';
            mistakes.forEach((mistake, idx) => {
                const div = document.createElement('div');
                div.className = 'mistake-item';
                div.innerHTML = `
                    <span class="mistake-word">${mistake.word}</span>
                    <span class="mistake-correct">✅ ${mistake.correctMeaning}</span>
                    <span class="mistake-wrong">❌ ${mistake.userAnswer}</span>
                    <button class="review-btn" onclick="speakSpecificWord('${mistake.word}')">🔊 استمع</button>
                `;
                container.appendChild(div);
            });
        }

        // عرض النتيجة النهائية
        function showResult() {
            const total = questions.length;
            const score = correctCount;
            const percent = Math.round((score / total) * 100);
            let message = '';
            if (percent >= 90) message = '🎖️ ممتاز! مستوى متقدم 🎖️';
            else if (percent >= 70) message = '🌟 جيد جداً! واصل التمرين 🌟';
            else if (percent >= 50) message = '📚 جيد، لكن راجع الكلمات التي أخطأت فيها 📚';
            else message = '📖 راجع القاموس جيداً ثم حاول مرة أخرى 📖';
            
            document.getElementById('finalScore').innerText = `${score}/${total}`;
            document.getElementById('finalMessage').innerHTML = `${message}<br><br>📊 النسبة: ${percent}%`;
            document.getElementById('resultModal').classList.remove('hide');
        }

        function closeResultAndRestart() {
            document.getElementById('resultModal').classList.add('hide');
            restartQuiz();
        }

        function restartQuiz() {
            correctCount = 0;
            wrongCount = 0;
            currentIndex = 0;
            mistakes = [];
            userAnswers = [];
            answerLocked = false;
            prepareQuestions();
            updateMistakesList();
            updateStats();
        }

        function clearMistakes() {
            mistakes = [];
            updateMistakesList();
        }

        // النطق الصوتي باستخدام Web Speech API
        function speakWord() {
            const word = document.getElementById('englishWord').innerText;
            speakSpecificWord(word);
        }

        function speakSpecificWord(word) {
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance(word);
                utterance.lang = 'en-US';
                utterance.rate = 0.9;
                utterance.pitch = 1;
                window.speechSynthesis.cancel();
                window.speechSynthesis.speak(utterance);
            } else {
                alert("متصفحك لا يدعم خاصية النطق الصوتي");
            }
        }

        window.onload = () => {
            prepareQuestions();
        };
    </script>
</body>
</html>
