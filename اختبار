    <title>اختبار القاموس الشخصي</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a472a 0%, #0d2818 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
        }

        /* بطاقة السؤال */
        .quiz-card {
            background: white;
            border-radius: 30px;
            padding: 30px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            margin-bottom: 20px;
        }

        .word-display {
            text-align: center;
            padding: 40px 20px;
            background: linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%);
            border-radius: 20px;
            margin-bottom: 30px;
        }

        .english-word {
            font-size: 48px;
            font-weight: bold;
            color: #1a472a;
            letter-spacing: 1px;
            word-break: break-word;
        }

        /* أزرار الصوت */
        .speaker-btn {
            background: #2e7d32;
            border: none;
            color: white;
            font-size: 28px;
            padding: 12px 20px;
            border-radius: 60px;
            cursor: pointer;
            margin-top: 15px;
            transition: transform 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .speaker-btn:hover {
            transform: scale(1.05);
            background: #1b5e20;
        }

        /* الخيارات */
        .options {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-bottom: 30px;
        }

        .option {
            background: #f1f3f4;
            border: 2px solid #ddd;
            border-radius: 60px;
            padding: 15px 25px;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 18px;
            text-align: right;
        }

        .option:hover {
            background: #e8f5e9;
            border-color: #2e7d32;
            transform: translateX(-5px);
        }

        .option.correct {
            background: #4caf50;
            color: white;
            border-color: #2e7d32;
        }

        .option.wrong {
            background: #f44336;
            color: white;
            border-color: #c62828;
        }

        .option.disabled {
            pointer-events: none;
            opacity: 0.7;
        }

        /* شريط التقدم */
        .progress-bar {
            background: #ddd;
            border-radius: 30px;
            height: 12px;
            margin-bottom: 15px;
            overflow: hidden;
        }

        .progress-fill {
            background: #2e7d32;
            height: 100%;
            width: 0%;
            transition: width 0.3s;
            border-radius: 30px;
        }

        .stats {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
            color: white;
            font-size: 16px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .stat-box {
            background: rgba(0,0,0,0.5);
            padding: 8px 16px;
            border-radius: 20px;
        }

        /* الأزرار */
        .btn {
            padding: 14px 28px;
            border: none;
            border-radius: 50px;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s;
            margin: 5px;
        }

        .btn-primary {
            background: #2e7d32;
            color: white;
        }

        .btn-primary:hover {
            background: #1b5e20;
            transform: scale(1.02);
        }

        .btn-secondary {
            background: #ff9800;
            color: white;
        }

        .btn-secondary:hover {
            background: #f57c00;
        }

        .btn-danger {
            background: #f44336;
            color: white;
        }

        /* قائمة الأخطاء */
        .mistakes-panel {
            background: white;
            border-radius: 30px;
            padding: 25px;
            margin-top: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .mistakes-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #ff9800;
        }

        .mistakes-list {
            max-height: 300px;
            overflow-y: auto;
        }

        .mistake-item {
            background: #fff3e0;
            border-radius: 15px;
            padding: 12px 20px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .mistake-word {
            font-weight: bold;
            color: #e65100;
            font-size: 18px;
        }

        .mistake-correct {
            color: #2e7d32;
        }

        .review-btn {
            background: #ff9800;
            border: none;
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 12px;
        }

        .empty-mistakes {
            text-align: center;
            color: #aaa;
            padding: 30px;
        }

        /* النتيجة النهائية */
        .result-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }

        .result-card {
            background: white;
            border-radius: 40px;
            padding: 40px;
            text-align: center;
            max-width: 400px;
            margin: 20px;
        }

        .score {
            font-size: 64px;
            font-weight: bold;
            color: #2e7d32;
            margin: 20px 0;
        }

        .hide {
            display: none;
        }

        .feedback {
            text-align: center;
            font-size: 18px;
            padding: 10px;
            margin-top: 10px;
            border-radius: 30px;
        }

        .feedback-correct {
            background: #c8e6c9;
            color: #2e7d32;
        }

        .feedback-wrong {
            background: #ffcdd2;
            color: #c62828;
        }

        @media (max-width: 600px) {
            .english-word { font-size: 32px; }
            .option { font-size: 14px; padding: 12px 18px; }
            .stat-box { font-size: 12px; }
        }
    </style>
