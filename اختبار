<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تحدي المفردات الإنجليزية - المطور</title>
    <style>
        :root {
            --primary: #4834d4;
            --secondary: #686de0;
            --success: #6ab04c;
            --danger: #eb4d4b;
            --bg: #f6f9fc;
            --text: #2d3436;
            --card-bg: #ffffff;
        }

        body {
            font-family: 'Cairo', 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #4834d4 0%, #686de0 100%);
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            color: var(--text);
        }

        .game-card {
            background: var(--card-bg);
            width: 90%;
            max-width: 480px;
            padding: 35px;
            border-radius: 30px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.3);
            text-align: center;
            position: relative;
            transform: translateY(0);
            transition: all 0.3s ease;
        }

        .header-stats {
            display: flex;
            justify-content: space-between;
            margin-bottom: 25px;
        }

        .stat-item {
            background: #f1f2f6;
            padding: 8px 18px;
            border-radius: 15px;
            font-weight: bold;
            font-size: 0.9rem;
            color: var(--primary);
        }

        .progress-bar-outer {
            width: 100%;
            height: 12px;
            background: #dfe4ea;
            border-radius: 10px;
            margin-bottom: 30px;
            overflow: hidden;
        }

        #progressBarInner {
            height: 100%;
            width: 0%;
            background: linear-gradient(to right, var(--success), #badc58);
            transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .question-label {
            color: #7f8c8d;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .word-display {
            font-size: 3.5rem;
            font-weight: 900;
            color: var(--primary);
            margin: 15px 0 35px 0;
            word-wrap: break-word;
        }

        .options-grid {
            display: grid;
            gap: 15px;
        }

        .option-card {
            background: white;
            border: 2px solid #edeff2;
            padding: 20px;
            border-radius: 18px;
            font-size: 1.25rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        }

        .option-card:hover {
            border-color: var(--secondary);
            background: #f8faff;
            transform: translateY(-3px);
        }

        .option-card:active { transform: scale(0.97); }

        .correct-anim { background: var(--success) !important; color: white !important; border-color: var(--success) !important; animation: bounce 0.5s; }
        .wrong-anim { background: var(--danger) !important; color: white !important; border-color: var(--danger) !important; animation: shake 0.4s; }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }

        @keyframes bounce {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.08); }
        }

        .footer-count {
            margin-top: 30px;
            color: #95a5a6;
            font-size: 0.85rem;
        }

        /* شاشة الفوز */
        .win-screen h1 { color: var(--success); font-size: 2.5rem; }
    </style>
</head>
