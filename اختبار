    // محرك صوتي بسيط (بدون ملفات)
    const audio = new (window.AudioContext || window.webkitAudioContext)();
    function beep(f, d) {
        const o = audio.createOscillator();
        const g = audio.createGain();
        o.connect(g); g.connect(audio.destination);
        o.frequency.value = f; g.gain.value = 0.1;
        o.start(); g.gain.exponentialRampToValueAtTime(0.0001, audio.currentTime + d);
        o.stop(audio.currentTime + d);
    }

    function init() {
        currentList = [...dictionary].sort(() => Math.random() - 0.5);
        document.getElementById('totalCount').innerText = totalCount;
        render();
    }

    function render() {
        if (currentList.length === 0) {
            finish(); return;
        }
        lock = false;
        const q = currentList[0];
        document.getElementById('wordText').innerText = q.en;
        document.getElementById('scoreDisplay').innerText = score;
        document.getElementById('doneCount').innerText = totalCount - currentList.length;
        document.getElementById('progressBarInner').style.width = ((totalCount - currentList.length) / totalCount * 100) + "%";

        let opts = [q.ar];
        while (opts.length < 4) {
            let r = dictionary[Math.floor(Math.random() * totalCount)].ar;
            if (!opts.includes(r)) opts.push(r);
        }
        opts.sort(() => Math.random() - 0.5);

        const container = document.getElementById('optionsContainer');
        container.innerHTML = '';
        opts.forEach(o => {
            const div = document.createElement('div');
            div.className = 'option-card';
            div.innerText = o;
            div.onclick = () => check(o, div);
            container.appendChild(div);
        });
    }

    function check(choice, el) {
        if (lock) return;
        lock = true;
        const correct = currentList[0].ar;
        if (choice === correct) {
            el.classList.add('correct-anim');
            beep(600, 0.3); score++;
        } else {
            el.classList.add('wrong-anim');
            beep(200, 0.3);
            Array.from(document.getElementsByClassName('option-card')).forEach(card => {
                if (card.innerText === correct) card.classList.add('correct-anim');
            });
        }
        currentList.shift();
        setTimeout(render, 1100);
    }

    function finish() {
        document.getElementById('gameBox').innerHTML = `
            <div class="win-screen">
                <h1>🎉 مبروك!</h1>
                <p>لقد أتممت مراجعة جميع الكلمات.</p>
