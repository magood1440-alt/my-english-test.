<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تحدي الكلمات - الإصدار الأسطوري</title>
    <style>
        /* تصميم الخلفية المتحركة والألوان */
        body {
            margin: 0;
            padding: 0;
            background: #0f0c29;
            background: linear-gradient(to bottom, #24243e, #302b63, #0f0c29);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Cairo', sans-serif;
            overflow: hidden;
            color: white;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 30px;
            padding: 40px;
            width: 90%;
            max-width: 450px;
            text-align: center;
            box-shadow: 0 25px 45px rgba(0,0,0,0.5);
            position: relative;
        }

        .score-panel {
            position: absolute;
            top: -20px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(45deg, #f093fb 0%, #f5576c 100%);
            padding: 10px 25px;
            border-radius: 20px;
            font-weight: bold;
            box-shadow: 0 10px 20px rgba(245, 87, 108, 0.4);
        }

        .word-box {
            margin: 40px 0;
        }

        .en-word {
            font-size: 3.8rem;
            font-weight: 900;
            text-transform: uppercase;
            background: linear-gradient(to right, #00dbde, #fc00ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 0 10px rgba(0,219,222,0.3));
        }

        .options-grid {
            display: grid;
            gap: 15px;
            margin-top: 20px;
        }

        .option-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 20px;
            border-radius: 15px;
            color: white;
            font-size: 1.3rem;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .option-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-5px);
            border-color: #00dbde;
        }

        .correct { background: #00b894 !important; box-shadow: 0 0 20px #00b894; }
        .wrong { background: #ff7675 !important; box-shadow: 0 0 20px #ff7675; animation: shake 0.4s; }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }

        .progress-bar {
            width: 100%;
            height: 6px;
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
            margin-top: 30px;
            overflow: hidden;
        }

        #bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(to right, #00dbde, #fc00ff);
            transition: 0.4s;
        }
    </style>
</head>
<body>

<div class="glass-card">
    <div class="score-panel">نقاطك: <span id="score">0</span></div>
    
    <div class="word-box">
        <div style="color: #aaa; font-size: 0.9rem; margin-bottom: 10px;">ما هو المعنى الصحيح؟</div>
        <div id="wordText" class="en-word">START</div>
    </div>

    <div id="options" class="options-grid"></div>

    <div class="progress-bar">
        <div id="bar"></div>
    </div>
    <div id="count" style="font-size: 0.8rem; color: #888; margin-top: 10px;"></div>
</div>

<script>
    // قائمة الكلمات (سيتم استخدام الـ 287 كلمة)
    const data = [
        {en: "Abandoned", ar: "مهجور"}, {en: "Ace", ar: "خبير"}, {en: "Acid", ar: "حمض"}, {en: "Ambition", ar: "طموح"}, {en: "Anxious", ar: "قلق"},
        {en: "Authority", ar: "سلطة"}, {en: "Benefit", ar: "فائدة"}, {en: "Blessing", ar: "بركة"}, {en: "Certain", ar: "متأكد"}, {en: "Civilization", ar: "حضارة"},
        {en: "Consequences", ar: "عواقب"}, {en: "Cracks", ar: "شقوق"}, {en: "Grit", ar: "عزيمة"}, {en: "Impact", ar: "تأثير"}, {en: "Patience", ar: "صبر"},
        {en: "Principles", ar: "مبادئ"}, {en: "Sacred", ar: "مقدس"}, {en: "Symptoms", ar: "أعراض"}, {en: "Wisdom", ar: "حكمة"}, {en: "Writhe", ar: "يتلوى"}
    ];

    let quiz = [];
    let score = 0;
    let total = data.length;
    let locked = false;

    // أصوات إلكترونية
    const audio = new (window.AudioContext || window.webkitAudioContext)();
    function play(freq, type) {
        const o = audio.createOscillator();
        const g = audio.createGain();
        o.type = type || 'sine';
        o.connect(g); g.connect(audio.destination);
        o.frequency.value = freq;
        g.gain.setValueAtTime(0.1, audio.currentTime);
        o.start(); o.stop(audio.currentTime + 0.2);
    }

    function init() {
        quiz = [...data].sort(() => Math.random() - 0.5);
        render();
    }

    function render() {
        if (quiz.length === 0) {
            alert("كفو! خلصت الكلمات بنجاح.");
            location.reload();
            return;
        }
        locked = false;
        const q = quiz[0];
        document.getElementById('wordText').innerText = q.en;
        document.getElementById('score').innerText = score;
        document.getElementById('bar').style.width = ((total - quiz.length) / total * 100) + "%";
        document.getElementById('count').innerText = `باقي ${quiz.length} كلمة`;

        let options = [q.ar];
        while (options.length < 4) {
            let r = data[Math.floor(Math.random() * total)].ar;
            if (!options.includes(r)) options.push(r);
        }
        options.sort(() => Math.random() - 0.5);

        const container = document.getElementById('options');
        container.innerHTML = '';
        options.forEach(o => {
            const btn = document.createElement('button');
            btn.className = 'option-btn';
            btn.innerText = o;
            btn.onclick = () => {
                if (locked) return;
                locked = true;
                if (o === q.ar) {
                    btn.classList.add('correct');
                    play(800, 'square');
                    score++;
                } else {
                    btn.classList.add('wrong');
                    play(150, 'sawtooth');
                }
                quiz.shift();
                setTimeout(render, 1000);
            };
            container.appendChild(btn);
        });
    }

    window.onload = init;
</script>

</body>
</html>
