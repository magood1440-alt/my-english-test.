<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تحدي الكلمات - الإصدار الاحترافي</title>
    <style>
        :root {
            --primary: #FF3CAC;
            --gradient: linear-gradient(225deg, #FF3CAC 0%, #784BA0 50%, #2B86C5 100%);
            --success: #00b894;
            --danger: #ff7675;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #1a1a2e; /* خلفية داكنة فخمة */
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            color: white;
        }

        .main-container {
            background: #16213e;
            padding: 30px;
            border-radius: 25px;
            box-shadow: 0 0 30px rgba(255, 60, 172, 0.2);
            width: 90%;
            max-width: 450px;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .score-box {
            font-size: 1.1rem;
            color: #FF3CAC;
            margin-bottom: 15px;
            font-weight: bold;
        }

        .progress-bar {
            width: 100%;
            height: 8px;
            background: #0f3460;
            border-radius: 10px;
            margin-bottom: 30px;
            overflow: hidden;
        }

        #progressFill {
            height: 100%;
            width: 0%;
            background: var(--gradient);
            transition: width 0.4s;
        }

        .word-title {
            font-size: 0.9rem;
            color: #888;
            margin-bottom: 5px;
        }

        .en-text {
            font-size: 3.2rem;
            font-weight: 800;
            background: var(--gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 30px;
            display: block;
        }

        .options-list {
            display: grid;
            gap: 15px;
        }

        .btn-opt {
            background: #0f3460;
            border: 2px solid #1a1a2e;
            padding: 18px;
            border-radius: 15px;
            color: white;
            font-size: 1.2rem;
            cursor: pointer;
            transition: 0.3s;
            font-weight: 600;
        }

        .btn-opt:hover {
            transform: scale(1.03);
            border-color: #FF3CAC;
        }

        .is-correct { background: var(--success) !important; border-color: var(--success) !important; }
        .is-wrong { background: var(--danger) !important; border-color: var(--danger) !important; animation: shake 0.4s; }

        @keyframes shake {
            0% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            50% { transform: translateX(10px); }
            75% { transform: translateX(-10px); }
            100% { transform: translateX(0); }
        }
    </style>
</head>
<body>

<div class="main-container">
    <div class="score-box">النقاط: <span id="score">0</span></div>
    
    <div class="progress-bar">
        <div id="progressFill"></div>
    </div>

    <div class="word-title">المعنى الصحيح لـ:</div>
    <span id="wordDisplay" class="en-text">Loading...</span>

    <div id="optionsContainer" class="options-list"></div>
</div>

<script>
    // مصفوفة الكلمات (سيتم استخدام الـ 287 كلمة)
    const wordsList = [
        {en: "Abandoned", ar: "مهجور"}, {en: "Ace", ar: "خبير"}, {en: "Acid", ar: "حمض"}, {en: "Ambition", ar: "طموح"}, {en: "Anxious", ar: "قلق"},
        {en: "Authority", ar: "سلطة"}, {en: "Benefit", ar: "فائدة"}, {en: "Blessing", ar: "بركة"}, {en: "Certain", ar: "متأكد"}, {en: "Civilization", ar: "حضارة"},
        {en: "Consequences", ar: "عواقب"}, {en: "Cracks", ar: "شقوق"}, {en: "Grit", ar: "عزيمة"}, {en: "Impact", ar: "تأثير"}, {en: "Patience", ar: "صبر"},
        {en: "Principles", ar: "مبادئ"}, {en: "Sacred", ar: "مقدس"}, {en: "Symptoms", ar: "أعراض"}, {en: "Wisdom", ar: "حكمة"}, {en: "Writhe", ar: "يتلوى"}
        // ... اضف بقية كلماتك هنا بنفس التنسيق
    ];

    let currentSession = [];
    let score = 0;
    let total = wordsList.length;
    let isLocked = false;

    // محرك صوتي
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    function playNote(freq) {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.connect(g); g.connect(ctx.destination);
        o.frequency.value = freq;
        g.gain.setValueAtTime(0.1, ctx.currentTime);
        o.start();
        g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.5);
        o.stop(ctx.currentTime + 0.5);
    }

    function start() {
        currentSession = [...wordsList].sort(() => Math.random() - 0.5);
        score = 0;
        nextQuestion();
    }

    function nextQuestion() {
        if (currentSession.length === 0) {
            alert("انتهيت! درجتك: " + score);
            location.reload();
            return;
        }

        isLocked = false;
        const q = currentSession[0];
        document.getElementById('wordDisplay').innerText = q.en;
        document.getElementById('score').innerText = score;
        document.getElementById('progressFill').style.width = ((total - currentSession.length) / total * 100) + "%";

        let opts = [q.ar];
        while (opts.length < 4) {
            let r = wordsList[Math.floor(Math.random() * total)].ar;
            if (!opts.includes(r)) opts.push(r);
        }
        opts.sort(() => Math.random() - 0.5);

        const container = document.getElementById('optionsContainer');
        container.innerHTML = '';
        opts.forEach(o => {
            const b = document.createElement('button');
            b.className = 'btn-opt';
            b.innerText = o;
            b.onclick = () => {
                if (isLocked) return;
                isLocked = true;
                if (o === q.ar) {
                    b.classList.add('is-correct');
                    playNote(800);
                    score++;
                } else {
                    b.classList.add('is-wrong');
                    playNote(200);
                }
                currentSession.shift();
                setTimeout(nextQuestion, 1000);
            };
            container.appendChild(b);
        });
    }

    window.onload = start;
</script>

</body>
</html>
